<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- 어셈블리 이름을 패키지 ID 와 맞춘다 (코어 패키지와 같은 규칙). 네임스페이스는 그대로 둔다. -->
    <AssemblyName>DisruptorCS.Extensions.Hosting</AssemblyName>
    <RootNamespace>Disruptor.Extensions.Hosting</RootNamespace>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- 패키징. 공통 메타데이터는 Directory.Build.props 에 있다. -->
    <IsPackable>true</IsPackable>
    <PackageId>DisruptorCS.Extensions.Hosting</PackageId>
    <Title>DisruptorCS.Extensions.Hosting</Title>
    <Description>Microsoft.Extensions integration for DisruptorCS: DI registration, Generic Host lifecycle, and health checks.</Description>
    <PackageTags>disruptor;dependency-injection;hosting;healthcheck;aspnetcore;generic-host</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Disruptor/Disruptor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../build/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
