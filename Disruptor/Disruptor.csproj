<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!--
      어셈블리 이름을 패키지 ID 와 맞춘다. 공식 disruptor-net 패키지도 어셈블리 이름이 'Disruptor' 라서,
      벤치마크에서 둘을 나란히 참조하려면 이름이 달라야 한다. 네임스페이스는 Disruptor 그대로 유지한다.
    -->
    <AssemblyName>DisruptorCS</AssemblyName>
    <RootNamespace>Disruptor</RootNamespace>

    <!-- 성능 라이브러리 필수 설정 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <TieredPGO>true</TieredPGO>

    <!-- 품질 게이트 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- 패키징. 공통 메타데이터(작성자/라이선스/저장소/아이콘/MinVer)는 Directory.Build.props 에 있다. -->
    <IsPackable>true</IsPackable>
    <PackageId>DisruptorCS</PackageId>
    <Title>DisruptorCS</Title>
    <Description>LMAX Disruptor for C#, with a game-server layer: sharding, fixed-tick integration, and deterministic journal/replay.</Description>
    <PackageTags>disruptor;ringbuffer;lock-free;low-latency;game-server;high-performance;concurrency;queue</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- XxHash3: 저널 레코드 무결성 검증용. CRC32C 대비 수 배 빠르고 하드웨어 의존이 없다. -->
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />

    <!-- 수동 릴리스일수록 버전 실수 방지 장치가 필요하다. -->
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- nuget.org 는 상대 링크를 저장소로 되돌리지 못한다. 패키지 페이지 전용 README 를 따로 싣는다. -->
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../build/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Disruptor.Tests" />
    <InternalsVisibleTo Include="Disruptor.Benchmarks" />
    <InternalsVisibleTo Include="Disruptor.Soak" />
  </ItemGroup>

  <!--
    Analyzer 동봉: 설치하면 IDE 가 오용(async 핸들러, finally 없는 Publish, 캡처 람다,
    2의 거듭제곱 아닌 링 크기)을 컴파일 타임에 잡아준다.
    ReferenceOutputAssembly=false 로 참조는 걸지 않고 빌드 순서만 강제한다.
  -->
  <ItemGroup>
    <ProjectReference Include="../Disruptor.Analyzers/Disruptor.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PackAnalyzer" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_AnalyzerDll>$(MSBuildThisFileDirectory)../Disruptor.Analyzers/bin/$(Configuration)/netstandard2.0/Disruptor.Analyzers.dll</_AnalyzerDll>
    </PropertyGroup>
    <!--
      Analyzer 가 빠진 패키지는 조용히 기능이 하나 없는 채로 배포된다. 경로가 어긋나면 여기서 멈춘다.
    -->
    <Error Condition="!Exists('$(_AnalyzerDll)')"
           Text="Analyzer assembly not found at $(_AnalyzerDll). Build Disruptor.Analyzers in $(Configuration) before packing." />
    <ItemGroup>
      <None Include="$(_AnalyzerDll)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
