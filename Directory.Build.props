<Project>

  <!--
    두 패키지(DisruptorCS, DisruptorCS.Extensions.Hosting)가 릴리스마다 메타데이터가 갈라지지
    않도록 공통 값을 한곳에서 관리한다. 프로젝트 파일에서 같은 프로퍼티를 다시 정의하면
    그쪽이 이긴다(Directory.Build.props 는 프로젝트보다 먼저 평가된다).
  -->
  <PropertyGroup>
    <Authors>DisruptorCS Contributors</Authors>
    <Company>DisruptorCS Contributors</Company>
    <Copyright>Copyright (c) DisruptorCS Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jacking75/DisruptorCS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jacking75/DisruptorCS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/jacking75/DisruptorCS/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!--
    기본은 "패키징하지 않음". 배포하는 두 프로젝트만 명시적으로 켠다.
    실수로 `dotnet pack DisruptorCS.slnx` 를 돌려도 샘플/테스트가 nupkg 로 나오지 않는다.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    심볼/소스 링크. 사용자가 예외 스택에서 패키지 내부로 디버깅해 들어올 수 있어야 한다.
    SourceLink 는 .NET 8 이상 SDK 에 내장되어 있어 PackageReference 가 필요 없다.
    ContinuousIntegrationBuild 는 재현 가능한 빌드용이라 pack 시점에 build/pack.ps1 이 켠다.
  -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    MinVer: git 태그가 곧 패키지 버전이다. `v0.10.0` 태그 → 0.10.0.
    태그가 없는 상태에서는 MinVerMinimumMajorMinor 를 바닥으로 0.10.0-preview.0.N 이 나온다.
    즉 "다음 릴리스는 0.10.x" 라는 사실이 태그 이전에도 빌드 산출물에 드러난다.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.10</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

</Project>
